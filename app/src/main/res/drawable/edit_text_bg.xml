<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Состояние ошибки (красная линия снизу) -->
    <item android:state_enabled="true" android:state_focused="false">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" /> <!-- Прозрачный фон -->
        </shape>
    </item>
    <!-- Обычное состояние (серая линия снизу) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" /> <!-- Прозрачный фон -->
            <stroke android:width="1dp" android:color="#B6BECE" />
        </shape>
    </item>
</selector>