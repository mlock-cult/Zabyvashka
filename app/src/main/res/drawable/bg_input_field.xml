<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Плавный градиент: от полупрозрачного белого сверху к темному снизу -->
    <gradient
        android:angle="90"
        android:startColor="#26FFFFFF"
        android:centerColor="#1AFFFFFF"
        android:endColor="#0DFFFFFF"
        android:type="linear" />

    <!-- Максимальное скругление -->
    <corners android:radius="26dp" />

    <!-- Тонкая обводка для блика на стекле -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>